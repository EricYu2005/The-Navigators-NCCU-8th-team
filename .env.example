# 伺服器執行的連接埠（Port）
PORT=3000

# 環境模式：development 或 production
NODE_ENV=development

# ========================================================
# 🦙 Ollama 本地 Docker 容器連線設定
# ========================================================
# 本地 Ollama 容器網址 (預設埠號 11434)
OLLAMA_BASE_URL=http://localhost:11434

# 使用的本機模型名稱 (請填寫您已 pull 到容器中的模型，例如: llama3.2, llama3, qwen2.5, gemma2, taide)
OLLAMA_MODEL=llama3.2
