PORT=3000
NODE_ENV=development

# 雲端 LLM 設定 (推薦 Render 部署使用，至 aistudio.google.com 免費申請金鑰)
# 若設定 GEMINI_API_KEY，將自動啟用 Google Gemini 1.5 Flash 雲端即時推理 (24/7 在線)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 本地 LLM 設定 (本機開發或透過 ngrok/localtunnel 隧道穿透)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# DrugBank 官方 MCP 設定
DRUGBANK_MCP_URL=https://mcp.drugbank.com/mcp
DRUGBANK_API_KEY=

# 系統專屬管道逾時安全閥 (毫秒 - 依臨床經驗設定 25s~35s 耐心黃金閾值)
DRUGBANK_TIMEOUT_MS=10000
LLM_FAST_TIMEOUT_MS=28000
LLM_MCP_TIMEOUT_MS=35000

# LINE Login 第三方登入設定 (LINE Developers Console)
# 部署至 Render 時請在 Render Dashboard -> Environment 加入以下變數：
# LINE_CHANNEL_ID=你的ChannelID (例如: 200xxxxxxx)
# LINE_CHANNEL_SECRET=你的ChannelSecret (例如: e6xxxxxxxx)
# LINE_CALLBACK_URL=https://carenav-nin9.onrender.com/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://carenav-nin9.onrender.com/auth/line/callback

# LINE Messaging API 官方帳號推播提醒設定（需與 LINE Login 位於同一個 Provider）
LINE_MESSAGING_ACCESS_TOKEN=
LINE_BOT_BASIC_ID=@044ihumq
REMINDER_CRON_SECRET=
PUBLIC_APP_URL=https://carenav-nin9.onrender.com
