PORT=3000
NODE_ENV=development

# Google Cloud Vertex AI 設定（保健品包裝/成分表拍照多模態辨識）
# 本地開發可放 service_account.json 並設定 GCP_PROJECT_KEY；部署至 Render 可直接將整份 JSON 內容貼入 GCP_SERVICE_ACCOUNT_JSON
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_PROJECT_KEY=./service_account.json
GCP_SERVICE_ACCOUNT_JSON=
VERTEX_AI_MODEL=gemini-2.5-flash

# LINE Login 第三方登入設定 (LINE Developers Console)
# 部署至 Render 時請在 Render Dashboard -> Environment 加入以下變數：
# LINE_CHANNEL_ID=你的ChannelID (例如: 200xxxxxxx)
# LINE_CHANNEL_SECRET=你的ChannelSecret (例如: e6xxxxxxxx)
# LINE_CALLBACK_URL=https://carenav-nin9.onrender.com/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://carenav-nin9.onrender.com/auth/line/callback

# LINE Messaging API 官方帳號推播提醒設定（需與 LINE Login 位於同一個 Provider）
LINE_MESSAGING_ACCESS_TOKEN=
LINE_BOT_BASIC_ID=@044ihumq
REMINDER_CRON_SECRET=
PUBLIC_APP_URL=https://carenav-nin9.onrender.com
