# 伺服器執行的連接埠（Port）
PORT=3000

# 環境模式：development 或 production
NODE_ENV=development

# ========================================================
# 🤖 Gemini LLM 串接設定（兩種方式擇一即可）
# ========================================================

# 【方式一：GCP 服務帳號 (Vertex AI 模式)】
# 將 GCP Console 下載的金鑰 JSON 檔命名為 gcp-key.json 放在專案根目錄
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GCP_PROJECT_ID=800743381042
GCP_LOCATION=asia-east1

# 【方式二：Google AI Studio API Key 模式】
# 若使用 API Key，請前往 https://aistudio.google.com/ 取得並貼上：
# GEMINI_API_KEY=AIzaSy...
